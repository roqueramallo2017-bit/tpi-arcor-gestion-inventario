<bpmn:messageFlow id="m1" name="Orden de compra" sourceRef="T6" targetRef="P1"/><bpmn:messageFlow id="m2" name="Mercadería + remito" sourceRef="P3" targetRef="C1"/><bpmn:messageFlow id="m3" name="Reclamo" sourceRef="T9" targetRef="Pool_Proveedor"/>
</bpmn:collaboration>
<bpmn:process id="Proc_Arcor" name="Reposición y recepción de materias primas" isExecutable="false">
<bpmn:laneSet id="LaneSet_Arcor"><bpmn:lane id="L_compras" name="Compras y Abastecimiento"><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>LA</bpmn:flowNodeRef><bpmn:flowNodeRef>LB</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_prod" name="Producción"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_sis" name="Sistema de Gestión de Inventario"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>T12</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_dep" name="Depósito (Logística)"><bpmn:flowNodeRef>C1</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>G4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_cal" name="Control de Calidad"><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>G5</bpmn:flowNodeRef><bpmn:flowNodeRef>T13</bpmn:flowNodeRef><bpmn:flowNodeRef>E4</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S1" name="Orden de producción planificada"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="T1" name="Solicitar materia prima para la orden"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="T2" name="Verificar stock disponible (solo lotes APROBADO)"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G1" name="¿Stock suficiente?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T3" name="Registrar SALIDA y descontar del lote"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G2" name="¿Stock por debajo del mínimo?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="E1" name="Materia prima entregada"><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="G3" name=""><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T4" name="Generar alerta de reposición"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T5" name="Revisar alerta y seleccionar proveedor"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:userTask><bpmn:intermediateThrowEvent id="LA" name="A: emitir orden de compra"><bpmn:incoming>f11</bpmn:incoming><bpmn:linkEventDefinition id="LA_led" name="A"/></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="LB" name="A"><bpmn:outgoing>f12</bpmn:outgoing><bpmn:linkEventDefinition id="LB_led" name="A"/></bpmn:intermediateCatchEvent><bpmn:sendTask id="T6" name="Emitir orden de compra (OC)"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:sendTask><bpmn:intermediateCatchEvent id="C1" name="Mercadería recibida"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:messageEventDefinition id="C1_med"/></bpmn:intermediateCatchEvent><bpmn:userTask id="T8" name="Controlar mercadería contra remito y OC"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G4" name="¿Coincide con la OC?"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f18</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="T9" name="Rechazar entrega y reclamar al proveedor"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="E2" name="Entrega rechazada"><bpmn:incoming>f17</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="T10" name="Registrar lote OBSERVADO y movimiento ENTRADA"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T11" name="Inspeccionar lote (análisis de calidad)"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G5" name="¿Resultado de la inspección?"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing><bpmn:outgoing>f22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T12" name="Cambiar lote a APROBADO y actualizar stock"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E3" name="Stock repuesto y disponible"><bpmn:incoming>f23</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="T13" name="Marcar RECHAZADO y registrar AJUSTE de baja"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E4" name="Lote dado de baja"><bpmn:incoming>f24</bpmn:incoming></bpmn:endEvent>
